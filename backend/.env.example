DATABASE_URL=sqlite:///./rifas.db
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_MINUTES=10080
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Sandbox: prefijo pub_test_ / test_integrity_ / test_events_
WOMPI_PUBLIC_KEY=pub_test_zxxx
WOMPI_INTEGRITY_KEY=test_integrity_xxo
WOMPI_EVENTS_KEY=test_events_xxUVBq

# Imagen de premio: usa Cloudinary si estas variables existen.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
UPLOAD_DIR=uploads
APP_BASE_URL=http://127.0.0.1:8000

# WhatsApp Meta Cloud API. META_SANDBOX=true no envia mensajes reales.
META_SANDBOX=true
META_API_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v20.0
META_LANGUAGE_CODE=es_CO
META_TEMPLATE_PAYMENT_CONFIRMATION=payment_confirmation
